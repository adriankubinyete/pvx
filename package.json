{
  "name": "pvx-opentui",
  "version": "0.1.1",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "dev": "PVX_HOME=.dev/pvx bun run --watch apps/pvx/src/index.ts",
    "start": "bun apps/pvx/src/index.ts",
    "build": "bun run build:linux-amd64",
    "build:linux-amd64": "sh scripts/build.sh linux-amd64",
    "build:linux-arm64": "sh scripts/build.sh linux-arm64",
    "build:darwin-arm64": "sh scripts/build.sh darwin-arm64",
    "build:windows-amd64": "sh scripts/build.sh windows-amd64",
    "build:all": "bun run build:linux-amd64 && bun run build:linux-arm64 && bun run build:darwin-arm64 && bun run build:windows-amd64",
    "build:deps": "bun install --os='*' --cpu='*'",
    "dev:link": "bun scripts/dev-link.ts link",
    "dev:unlink": "bun scripts/dev-link.ts unlink",
    "release": "sh scripts/release.sh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "typescript": "~5.9.0"
  },
  "dependencies": {
    "@opentui/core": "0.5.17",
    "@opentui/react": "0.5.17",
    "react": "19.3.0"
  }
}
